# Source: https://github.com/emersonbusson/vramshared
# File: scripts/safety/systemd/ramshared-control.slice
[Unit]
Description=RamShared protected control plane
Before=ramshared-workloads.slice

[Slice]
ManagedOOMPreference=avoid
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
MemoryLow=1G
MemoryMin=512M
CPUWeight=1000
IOWeight=1000
