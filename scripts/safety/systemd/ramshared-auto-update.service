[Unit]
Description=RamShared sealed release auto-update
Documentation=file:///opt/ramshared/current/RELEASE_VERSION
# A sealed install is a transaction against /opt/ramshared/releases and a
# release-selector move. It is ordered after local-fs so the bundle tree and
# the policy file are both readable when it runs.
After=local-fs.target
RequiresMountsFor=/opt/ramshared

[Service]
Type=oneshot
# The native installer validates the installed update policy and release keyring.
Environment=RAMSHARED_SCHEDULED_UPDATE=1
ExecStart=/opt/ramshared/current/bin/ramshared install --auto-update
# Keep failed and successful local wakes within the same bounded hold.
ExecStopPost=/usr/bin/sleep 2
NonBlocking=true
Nice=19
IOSchedulingClass=idle
# Auto-update verifies OpenPGP trust before any effect. When the cascade is
# active, it checks canonical `down --plan` drain safety (deferring cleanly
# when headroom or authenticated host memory is unverified), performs ordered
# swapoff-first teardown, installs the verified release carrying enrollment
# forward, and immediately reactivates through the fail-closed host-gate/boot
# chain. It never forces swapoff, never applies pressure, and never runs drills.
NoNewPrivileges=false
PrivateTmp=true
# The bundle tree lives wherever the operator builds it, commonly under
# their home directory. `full` protects the system paths this script never
# writes and leaves that tree readable; `strict` would hide it and the
# scheduled run would report NO-BUNDLE forever.
ProtectHome=read-only
ProtectSystem=full
LogsDirectory=ramshared
ReadWritePaths=/opt/ramshared /etc/systemd/system -/etc/ramshared
TimeoutStartSec=900
